<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodeDesigner.Ps2.Multiplayer</AssemblyName>
    <RootNamespace>CodeDesigner.Ps2.Multiplayer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeDesigner.AI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <!-- DNAS gateway (https://github.com/FatalityDevelopment/DnaSDK), hosted in-process by Servers/DnasServer.cs. -->
  <ItemGroup>
    <ProjectReference Include="..\DnaSDK\DnaSDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Certificates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- DnaSDK's optional RSA moduli (diagnostic ticket decode in <DnasRsaDirectory>/Decoded). -->
    <Content Include="..\DnaSDK\Assets\Moduli\*.BIN" Link="Assets\Moduli\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Deploy build output to a 'Multiplayer' subdirectory inside the CodeDesigner
    install directory so the VSCode extension can locate the Multiplayer server
    without user configuration.  The subdirectory keeps Multiplayer assemblies
    isolated from the Bridge deployment to avoid DLL contamination.

    Install directory mirrors the C# DatabasePaths.GetInstallDirectory() logic:
      Windows  →  %LOCALAPPDATA%\CodeDesigner\Multiplayer\
      Linux/macOS →  $HOME/.local/share/CodeDesigner/Multiplayer/
  -->
  <Target Name="DeployToInstallDir" AfterTargets="Build" Condition="'$(SkipInstallDeploy)' != 'true'">
    <PropertyGroup>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)</_LocalAppData>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' == '' AND '$(HOME)' != ''">$(HOME)/.local/share</_LocalAppData>
      <_InstallDir Condition="'$(_LocalAppData)' != ''">$(_LocalAppData)/CodeDesigner/Multiplayer</_InstallDir>
      <!-- -p:CodeDesignerInstallDir=<dir> deploys somewhere else (the release packaging stages into a temp dir). -->
      <_InstallDir Condition="'$(CodeDesignerInstallDir)' != ''">$(CodeDesignerInstallDir)/Multiplayer</_InstallDir>
    </PropertyGroup>
    <MakeDir Directories="$(_InstallDir)" Condition="'$(_InstallDir)' != ''" />
    <ItemGroup Condition="'$(_InstallDir)' != ''">
      <!-- Never deploy logs or runtime data: a stale bin\multiplayer.log used to overwrite the live server log.
           Runtime data (server-data.json, bans, the patch, DNAS tickets/captures) lives in data\, which on Windows is the
           same folder as the shipped Data\<region>\packets — so exclude only the runtime parts, keep the packets. -->
      <_DeployFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.log;$(OutputPath)data\*;$(OutputPath)data\patch\**;$(OutputPath)data\dnas\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFiles="@(_DeployFiles->'$(_InstallDir)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(_InstallDir)' != ''" />
    <Message Text="[CodeDesigner.Multiplayer] Deployed to $(_InstallDir)" Importance="high" Condition="'$(_InstallDir)' != ''" />
  </Target>

</Project>
