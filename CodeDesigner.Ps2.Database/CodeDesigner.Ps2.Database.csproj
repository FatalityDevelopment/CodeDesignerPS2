<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodeDesigner.Ps2.Database</RootNamespace>
    <AssemblyName>CodeDesigner.Ps2.Database</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/SeedData/codedesigner_labels.json" />
    <EmbeddedResource Include="Resources/SeedData/socom_patch_labels.json" />
    <EmbeddedResource Include="Resources/SeedData/seed_games.json" />
    <EmbeddedResource Include="Resources/SeedData/seed_mcp_agents.json" />
    <EmbeddedResource Include="Resources/SeedData/seed_mcp_orchestrations.json" />
    <EmbeddedResource Include="Resources/SeedData/seed_memories.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    After every build, run the Database tool to apply pending EF Core migrations
    and seed the database.  The default connection string targets SQL Server Express
    LocalDB (Server=(localdb)\MSSQLLocalDB;Database=CodeDesigner;Trusted_Connection=True;).
    Override via the CODEDESIGNER_CONNECTION_STRING environment variable or pass
    a connection-string argument directly to the executable.
    Set the CheatArchiveRoot MSBuild property (or the CODEDESIGNER_ARCHIVE_ROOT
    environment variable) to also run the bulk cheat importer, e.g.:
        dotnet build -p:CheatArchiveRoot=/path/to/CheatCodeArchive
  -->
  <Target Name="InitialiseDatabase" AfterTargets="Build">
    <PropertyGroup>
      <_ArchiveArg Condition="'$(CheatArchiveRoot)' != ''">--archive-root &quot;$(CheatArchiveRoot)&quot;</_ArchiveArg>
      <_ArchiveArg Condition="'$(CheatArchiveRoot)' == ''"></_ArchiveArg>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(TargetPath)&quot; $(_ArchiveArg)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
