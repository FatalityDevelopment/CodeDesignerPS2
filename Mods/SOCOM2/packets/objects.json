  "packer": "SealState is packed from the CSealEx entity every frame by 0x002BF280 (state built at sp+0x30, then copied to the SealObject data block; data+0x8C = CSealEx*).",
  "object_header": {
    "_comment": "In-memory DME object (find by class-name string; base = name - 0x10). Verified live on mp61.",
    "+0x00": "u32 0x51 (constant)",
    "+0x04": "u16 type (0 Seal, 1 Persona, 2 Blather, 3 Grenade, 4 Game, 5 Bomb, 6 Platform)",
    "+0x06": "u16 flags: 0x0102 player-owned (Seal/Persona/Blather), 0x0002 host-global (Game/Bomb)",
    "+0x08": "u32 0",
    "+0x0C": "u32 owner (DME client index; 0 = host)",
    "+0x10": "char[16] class name",
    "+0x20": "ptr current state (class layout from objects.json); SealState+0x8C = CSealEx*",
    "+0x24": "ptr last-sent state copy (delta source for 00 03 updates)"
  },
  "object_table": {
    "_comment": "0x00675F20: DME object table, 256 x record* indexed by object id (exists flag 0x00679FE8[id] == 2). record = 0x51 word + 4: +0 u16 type, +2 flags, +8 owner, +0xC class name, +0x1C state, +0x20 last-sent copy. Lookup 0x0062A108(&out, id); DME_FindObjectById 0x002BF110 -> state+0x8C (CSealEx).",
    "ids_seen": {
      "0x00": "GameObject",
      "0x01": "host PersonaObject",
      "0x02": "BlatherObject",
      "0x03": "host SealObject",
      "0x04-0x06": "TurretObject (map turrets)",
      "0x07": "BombObject (round bomb)",
      "0x21-0x25": "bot PersonaObjects",
      "0x61-0x65": "bot SealObjects"
    }
  }
}