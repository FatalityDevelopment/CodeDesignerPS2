/CodeDesigner.Ps2.CdsLanguage/StdLib/snapshots/SCUS-97275/labels/SOCOM2_r0004.json
*.json
/CodeDesigner.Ps2.CdsLanguage/StdLib/emu-settings.json

# SOCOM II auto-login credentials (Mods/SOCOM2/bots/socom_bots.py login) - never commit
Mods/SOCOM2/auto_login.local.json

