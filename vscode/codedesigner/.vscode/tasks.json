// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm-install",
			"type": "npm",
			"script": "install",
			"presentation": {
				"reveal": "silent",
				"showReuseMessage": false
			},
			"problemMatcher": []
		},
		{
			"label": "compile",
			"type": "npm",
			"script": "compile",
			"dependsOn": ["npm-install"],
			"dependsOrder": "sequence",
			"problemMatcher": "$ts-webpack",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent"
			}
		},
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$ts-webpack-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": "build"
		},
		{
			"type": "npm",
			"script": "watch-tests",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": "build"
		}
	]
}
