{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["ES2020", "DOM"],
    "outDir": "./out-webview",
    "rootDir": "./src/webview",
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/webview/**/*"]
}
