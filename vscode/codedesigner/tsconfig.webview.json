{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "experimentalDecorators": true,
    "lib": ["ES2020", "DOM"],
    "outDir": "./out-webview",
    "rootDir": "./src/webview",
    "skipLibCheck": true,
    "sourceMap": true
  },
  "angularCompilerOptions": {
    "compilationMode": "full"
  },
  "files": [
    "src/webview/disasm-editor/main.ts",
    "src/webview/disasm-panel/main.ts",
    "src/webview/typings.d.ts"
  ],
  "exclude": [
    "src/webview/disasm-editor/components/index.ts",
    "src/webview/disasm-editor/state/editor.actions.ts",
    "src/webview/disasm-editor/state/index.ts",
    "src/webview/disasm-editor/utils/address.utils.ts",
    "src/webview/disasm-editor/utils/index.ts",
    "src/webview/disasm-editor/utils/registers.utils.ts"
  ]
}
