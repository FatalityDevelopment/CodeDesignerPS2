{
  "$schema": "https://json.schemastore.org/tmlanguage.json",
  "name": "Code Designer",
  "scopeName": "source.cds",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#functionDefinitions" },
    { "include": "#externFunctionDeclarations" },
    { "include": "#preprocessor" },
    { "include": "#labelReferences" },
    { "include": "#labels" },
    { "include": "#functionCalls" },
    { "include": "#directives" },
    { "include": "#sidecars" },
    { "include": "#pseudoInstructions" },
    { "include": "#instructions" },
    { "include": "#argumentOffsets" },
    { "include": "#registers" },
    { "include": "#hexLiterals" },
    { "include": "#numbers" },
    { "include": "#operandPunctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.cds", "match": "//.*$" },
        { "name": "comment.line.semicolon.cds", "match": ";.*$" },
        { "name": "comment.line.hash.cds", "match": "#.*$" },
        { "name": "comment.block.cds", "begin": "/\\*", "end": "\\*/" }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cds",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.cds", "match": "\\\\." }
          ]
        }
      ]
    },

    "functionDefinitions": {
      "patterns": [
        {
          "comment": "function NAME(p1, p2, ...) {  — highlights NAME as definition and each parameter as a parameter binding.",
          "match": "^\\s*(function)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)\\s*(\\{)?",
          "captures": {
            "1": { "name": "keyword.declaration.function.cds" },
            "2": { "name": "entity.name.function.definition.cds" },
            "3": {
              "patterns": [
                {
                  "match": "[A-Za-z_][A-Za-z0-9_]*",
                  "name": "variable.parameter.cds"
                }
              ]
            },
            "4": { "name": "punctuation.definition.block.cds" }
          }
        }
      ]
    },

    "externFunctionDeclarations": {
      "patterns": [
        {
          "comment": "extern function NAME(p1, p2, ...) at :label  — highlights structurally so users can see the name, parameters, and target label distinctly.",
          "match": "^\\s*(extern)\\s+(function)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)\\s+(at)\\s+(:[A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.modifier.extern.cds" },
            "2": { "name": "keyword.declaration.function.cds" },
            "3": { "name": "entity.name.function.declaration.cds" },
            "4": {
              "patterns": [
                { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "variable.parameter.cds" }
              ]
            },
            "5": { "name": "keyword.other.at.cds" },
            "6": { "name": "entity.name.label.reference.cds" }
          }
        }
      ]
    },

    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.definition.cds",
          "match": "^[A-Za-z_][A-Za-z0-9_]*:"
        }
      ]
    },

    "labelReferences": {
      "patterns": [
        {
          "name": "entity.name.label.reference.cds",
          "match": ":[A-Za-z_][A-Za-z0-9_.]*"
        }
      ]
    },

    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.preprocessor.cds",
          "match": "\\b(const|alias|macro|endmacro|include|if|else|endif|while|endwhile|repeat|endrepeat|extern|function)\\b"
        }
      ]
    },

    "directives": {
      "patterns": [
        {
          "name": "keyword.directive.cds",
          "match": "\\b(address|hexcode|setreg|mem|load|store|pointer|string|scope)\\b"
        },
        {
          "name": "keyword.directive.mips",
          "match": "\\.(text|data|bss|align|globl|global|section|set|macro|endm|ascii|string|byte|half|word|dword|float|double)\\b"
        }
      ]
    },

    "sidecars": {
      "patterns": [
        {
          "name": "keyword.sidecar.cds",
          "match": "\\b(assert|breakpoint|watchpoint|log|print|freeze|cond|endcond|timer|endtimer)\\b"
        }
      ]
    },

    "pseudoInstructions": {
      "patterns": [
        {
          "name": "keyword.instruction.pseudo.cds",
          "match": "\\b(setreg|la|move|li|not|negu|bnez|beqz|b|blt|bgt|ble|bge)\\b"
        }
      ]
    },

    "functionCalls": {
      "patterns": [
        {
          "comment": "Highlight an identifier immediately followed by `(` as a function call. Real MIPS instructions and directives never use the `name(args)` shape, so this is unambiguous.",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.cds" }
          }
        }
      ]
    },

    "instructions": {
      "patterns": [
        {
          "name": "keyword.instruction.cds",
          "match": "\\b(NOP|ADD|ADDI|ADDIU|ADDU|AND|ANDI|BEQ|BEQL|BGEZ|BGEZAL|BGEZALL|BGEZL|BGTZ|BGTZL|BLEZ|BLEZL|BLTZ|BLTZAL|BLTZALL|BLTZL|BNE|BNEL|BREAK|DADD|DADDI|DADDIU|DADDU|DIV|DIVU|DSLL|DSLL32|DSLLV|DSRA|DSRA32|DSRAV|DSRL|DSRL32|DSRLV|DSUB|DSUBU|J|JAL|JALR|JR|LB|LBU|LD|LDL|LDR|LH|LHU|LUI|LW|LWL|LWR|LWU|MFHI|MFLO|MOVN|MOVZ|MTLO|MULT|MULTU|NOR|OR|ORI|PREF|SB|SD|SDL|SDR|SH|SLL|SLLV|SLT|SLTI|SLTIU|SLTU|SRA|SRAV|SRL|SRLV|SUB|SUBU|SW|SWL|SWR|SYNC|SYNC\\.P|SYSCALL|TEQ|TEQI|TGE|TGEI|TGEIU|TGEU|TLT|TLTI|TLTIU|TLTU|TNE|TNEI|XOR|XORI|DIV1|DIVU1|LQ|MADD|MADD1|MADDU|MFHI1|MFLO1|MFSA|MTHI1|MTLO1|MTSA|MTSAB|MTSAH|MULT1|MULTU1|PABSH|PABSW|PADDB|PADDH|PADDSB|PADDSH|PADDSW|PADDUB|PADDUH|PADDUW|PADDW|PADSBH|PAND|PCEQB|PCEQH|PCEQW|PCGTB|PCGTH|PCGTW|PCPYH|PCPYLD|PCPYUD|PDIVBW|PDIVUW|PDIVW|PEXCH|PEXCW|PEXEH|PEXEW|PEXT5|PEXTLB|PEXTLH|PEXTLW|PEXTUB|PEXTUH|PEXTUW|PHMADH|PHMSBH|PINTEH|PINTH|PLZCW|PMADDH|PMADDUW|PMADDW|PMAXH|PMAXW|PMFHI|PMFHL\\.LH|PMFHL\\.LW|PMFHL\\.SH|PMFHL\\.SLW|PMFHL\\.UW|PMFLO|PMINH|PMINW|PMSUBH|PMSUBW|PMTHI|PMTHL\\.LW|PMTLO|PMULTH|PMULTUW|PMULTW|PNOR|POR|PPAC5|PPACB|PPACH|PPACW|PREVH|PROT3W|PSLLH|PSLLVW|PSLLW|PSRAH|PSRAVW|PSRAW|PSRLH|PSRLVW|PSRLW|PSUBB|PSUBH|PSUBSB|PSUBSH|PSUBSW|PSUBUB|PSUBUH|PSUBUW|PSUBW|PXOR|QFSRV|SQ|BC0F|BC0FL|BC0T|BC0TL|DI|EI|ERET|MFC0|MTC0|ABS\\.S|ADD\\.S|ADDA\\.S|BC1F|BC1FL|BC1T|BC1TL|C\\.EQ\\.S|C\\.F\\.S|C\\.LE\\.S|C\\.LT\\.S|CFC1|CTC1|CVT\\.S\\.W|CVT\\.W\\.S|DIV\\.S|LWC1|MADD\\.S|MADDA\\.S|MAX\\.S|MFC1|MIN\\.S|MOV\\.S|MSUB\\.S|MSUBA\\.S|MTC1|MUL\\.S|MULA\\.S|NEG\\.S|RSQRT\\.S|SQRT\\.S|SUB\\.S|SUBA\\.S|SWC1)\\b"
        }
      ]
    },

    "hexLiterals": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cds",
          "match": "\\$[0-9A-Fa-f]{2,8}\\b"
        }
      ]
    },

    "argumentOffsets": {
      "patterns": [
        {
          "comment": "Disassembler-style stack/base offsets such as $1234(sp); scope $ and the 16-bit offset separately to mirror the webview operand colors.",
          "match": "(\\$)([0-9A-Fa-f]{4})(?=\\()",
          "captures": {
            "1": { "name": "punctuation.definition.numeric-sigil.cds" },
            "2": { "name": "constant.numeric.offset.cds" }
          }
        }
      ]
    },

    "registers": {
      "patterns": [
        {
          "comment": "$zero / zero — always-zero constant. Captures the optional $ separately so .cds mirrors the disassembler editor sigil color.",
          "match": "(?<![A-Za-z0-9_])(\\$?)(zero)(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.zero.cds" }
          }
        },
        {
          "comment": "$at / at — assembler temporary",
          "match": "(?<![A-Za-z0-9_])(\\$?)(at)(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.at.cds" }
          }
        },
        {
          "comment": "$v0/$v1 — function return values",
          "match": "(?<![A-Za-z0-9_])(\\$?)(v[01])(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.value.cds" }
          }
        },
        {
          "comment": "$a0-$a3 — call arguments",
          "match": "(?<![A-Za-z0-9_])(\\$?)(a[0-3])(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.arg.cds" }
          }
        },
        {
          "comment": "$t0-$t9 — caller-saved temporaries",
          "match": "(?<![A-Za-z0-9_])(\\$?)(t[0-9])(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.temp.cds" }
          }
        },
        {
          "comment": "$s0-$s7 — callee-saved registers",
          "match": "(?<![A-Za-z0-9_])(\\$?)(s[0-7])(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.saved.cds" }
          }
        },
        {
          "comment": "$k0/$k1 — kernel-reserved registers",
          "match": "(?<![A-Za-z0-9_])(\\$?)(k[01])(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.kernel.cds" }
          }
        },
        {
          "comment": "$gp — global pointer",
          "match": "(?<![A-Za-z0-9_])(\\$?)(gp)(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.gp.cds" }
          }
        },
        {
          "comment": "$sp — stack pointer",
          "match": "(?<![A-Za-z0-9_])(\\$?)(sp)(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.sp.cds" }
          }
        },
        {
          "comment": "$fp — frame pointer",
          "match": "(?<![A-Za-z0-9_])(\\$?)(fp)(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.fp.cds" }
          }
        },
        {
          "comment": "$ra — return address",
          "match": "(?<![A-Za-z0-9_])(\\$?)(ra)(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "punctuation.definition.register-sigil.cds" },
            "2": { "name": "variable.register.ra.cds" }
          }
        },
        {
          "comment": "$0-$31 and $r0-$r31 numeric register forms. Listed before hex literals so $10 is treated as a register instead of a hex literal.",
          "name": "variable.register.numeric.cds",
          "match": "\\$r?(?:[0-9]|[12][0-9]|3[01])\\b|(?<![A-Za-z0-9_])r(?:[0-9]|[12][0-9]|3[01])(?![A-Za-z0-9_])"
        },
        {
          "comment": "$f0-$f31 — floating-point registers. Listed before hex literals so $f0 is treated as a register.",
          "name": "variable.register.fpu.cds",
          "match": "\\$f(?:[0-9]|[12][0-9]|3[01])\\b"
        }
      ]
    },

    "operandPunctuation": {
      "patterns": [
        { "name": "punctuation.separator.operand.cds", "match": "," },
        { "name": "punctuation.section.parens.operand.cds", "match": "[()]" }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.cds",
          "match": "\\b-?\\d+\\b"
        }
      ]
    }
  }
}
