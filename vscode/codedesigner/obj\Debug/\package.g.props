<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PackageJsonName Condition="$(PackageJsonName) == ''">codedesigner</PackageJsonName>
    <PackageJsonDisplayname Condition="$(PackageJsonDisplayname) == ''">CodeDesigner</PackageJsonDisplayname>
    <PackageJsonDescription Condition="$(PackageJsonDescription) == ''">A very cool description</PackageJsonDescription>
    <PackageJsonVersion Condition="$(PackageJsonVersion) == ''">0.0.1</PackageJsonVersion>
    <PackageJsonEnginesVscode Condition="$(PackageJsonEnginesVscode) == ''">^1.108.1</PackageJsonEnginesVscode>
    <PackageJsonMain Condition="$(PackageJsonMain) == ''">./dist/extension.js</PackageJsonMain>
    <PackageJsonCategories Condition="$(PackageJsonCategories) == ''">[
  "Debuggers"
]</PackageJsonCategories>
    <PackageJsonContributesCustomeditors Condition="$(PackageJsonContributesCustomeditors) == ''">[
  {
    "viewType": "disasm.disasmEditor",
    "displayName": "Disassembler",
    "selector": [
      {
        "filenamePattern": "*.bin"
      }
    ]
  }
]</PackageJsonContributesCustomeditors>
    <PackageJsonContributesViewscontainersActivitybar Condition="$(PackageJsonContributesViewscontainersActivitybar) == ''">[
  {
    "id": "disasmSidebar",
    "title": "disasm",
    "icon": "dist/resources/disasm-icon.svg"
  },
  {
    "id": "asmSidebar",
    "title": "asm",
    "icon": "dist/resources/asm-icon.svg"
  }
]</PackageJsonContributesViewscontainersActivitybar>
    <PackageJsonContributesViewsDisasmsidebar Condition="$(PackageJsonContributesViewsDisasmsidebar) == ''">[
  {
    "type": "webview",
    "id": "disasm.disasmPanel",
    "name": "Disasm Panel"
  }
]</PackageJsonContributesViewsDisasmsidebar>
    <PackageJsonContributesViewsAsmsidebar Condition="$(PackageJsonContributesViewsAsmsidebar) == ''">[
  {
    "type": "webview",
    "id": "asm.asmPanel",
    "name": "Asm Panel"
  }
]</PackageJsonContributesViewsAsmsidebar>
    <PackageJsonContributesCommands Condition="$(PackageJsonContributesCommands) == ''">[
  {
    "command": "disasm.showPanel",
    "title": "Show Disasm Panel"
  },
  {
    "command": "asm.showPanel",
    "title": "Show Asm Panel"
  },
  {
    "command": "codedesigner.connectServer",
    "title": "CodeDesigner: Connect to Server"
  },
  {
    "command": "codedesigner.disconnectServer",
    "title": "CodeDesigner: Disconnect from Server"
  },
  {
    "command": "codedesigner.sendMessage",
    "title": "CodeDesigner: Send Message to Server"
  }
]</PackageJsonContributesCommands>
    <PackageJsonContributesLanguages Condition="$(PackageJsonContributesLanguages) == ''">[
  {
    "id": "cds",
    "aliases": [
      "Code Designer Source",
      "cds"
    ],
    "extensions": [
      "cds"
    ],
    "configuration": "./dist/language-configuration.json"
  }
]</PackageJsonContributesLanguages>
    <PackageJsonContributesGrammars Condition="$(PackageJsonContributesGrammars) == ''">[
  {
    "language": "cds",
    "scopeName": "source.cds",
    "path": "./syntaxes/cds.tmLanguage.json"
  }
]</PackageJsonContributesGrammars>
    <PackageJsonScriptsVscodePrepublish Condition="$(PackageJsonScriptsVscodePrepublish) == ''">npm run package</PackageJsonScriptsVscodePrepublish>
    <PackageJsonScriptsCompile Condition="$(PackageJsonScriptsCompile) == ''">webpack</PackageJsonScriptsCompile>
    <PackageJsonScriptsBuild Condition="$(PackageJsonScriptsBuild) == ''">npm run compile</PackageJsonScriptsBuild>
    <PackageJsonScriptsWatch Condition="$(PackageJsonScriptsWatch) == ''">webpack --watch</PackageJsonScriptsWatch>
    <PackageJsonScriptsPackage Condition="$(PackageJsonScriptsPackage) == ''">webpack --mode production --devtool hidden-source-map</PackageJsonScriptsPackage>
    <PackageJsonScriptsCompileTests Condition="$(PackageJsonScriptsCompileTests) == ''">tsc -p . --outDir out</PackageJsonScriptsCompileTests>
    <PackageJsonScriptsWatchTests Condition="$(PackageJsonScriptsWatchTests) == ''">tsc -p . -w --outDir out</PackageJsonScriptsWatchTests>
    <PackageJsonScriptsPretest Condition="$(PackageJsonScriptsPretest) == ''">npm run compile-tests &amp;&amp; npm run compile &amp;&amp; npm run lint</PackageJsonScriptsPretest>
    <PackageJsonScriptsLint Condition="$(PackageJsonScriptsLint) == ''">eslint src</PackageJsonScriptsLint>
    <PackageJsonScriptsTest Condition="$(PackageJsonScriptsTest) == ''">vscode-test</PackageJsonScriptsTest>
    <PackageJsonDevdependenciesTypesMocha Condition="$(PackageJsonDevdependenciesTypesMocha) == ''">^10.0.10</PackageJsonDevdependenciesTypesMocha>
    <PackageJsonDevdependenciesTypesNode Condition="$(PackageJsonDevdependenciesTypesNode) == ''">22.x</PackageJsonDevdependenciesTypesNode>
    <PackageJsonDevdependenciesTypesVscode Condition="$(PackageJsonDevdependenciesTypesVscode) == ''">^1.108.1</PackageJsonDevdependenciesTypesVscode>
    <PackageJsonDevdependenciesVscodeTestCli Condition="$(PackageJsonDevdependenciesVscodeTestCli) == ''">^0.0.12</PackageJsonDevdependenciesVscodeTestCli>
    <PackageJsonDevdependenciesVscodeTestElectron Condition="$(PackageJsonDevdependenciesVscodeTestElectron) == ''">^2.5.2</PackageJsonDevdependenciesVscodeTestElectron>
    <PackageJsonDevdependenciesCopyWebpackPlugin Condition="$(PackageJsonDevdependenciesCopyWebpackPlugin) == ''">^13.0.1</PackageJsonDevdependenciesCopyWebpackPlugin>
    <PackageJsonDevdependenciesEslint Condition="$(PackageJsonDevdependenciesEslint) == ''">^9.39.2</PackageJsonDevdependenciesEslint>
    <PackageJsonDevdependenciesTsLoader Condition="$(PackageJsonDevdependenciesTsLoader) == ''">^9.5.4</PackageJsonDevdependenciesTsLoader>
    <PackageJsonDevdependenciesTypescript Condition="$(PackageJsonDevdependenciesTypescript) == ''">^5.9.3</PackageJsonDevdependenciesTypescript>
    <PackageJsonDevdependenciesTypescriptEslint Condition="$(PackageJsonDevdependenciesTypescriptEslint) == ''">^8.52.0</PackageJsonDevdependenciesTypescriptEslint>
    <PackageJsonDevdependenciesWebpack Condition="$(PackageJsonDevdependenciesWebpack) == ''">^5.104.1</PackageJsonDevdependenciesWebpack>
    <PackageJsonDevdependenciesWebpackCli Condition="$(PackageJsonDevdependenciesWebpackCli) == ''">^6.0.1</PackageJsonDevdependenciesWebpackCli>
    <PackageJsonDependenciesVscodeWebviewUiToolkit Condition="$(PackageJsonDependenciesVscodeWebviewUiToolkit) == ''">^1.4.0</PackageJsonDependenciesVscodeWebviewUiToolkit>
  </PropertyGroup>
</Project>