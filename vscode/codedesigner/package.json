{
  "name": "codedesigner",
  "displayName": "CodeDesigner",
  "description": "A very cool description",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.1"
  },
  "main": "./dist/extension.js",
  "categories": [
    "Debuggers"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "disasm.disasmEditor",
        "displayName": "Disassembler",
        "selector": [
          {
            "filenamePattern": "*.bin"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "disasmSidebar",
          "title": "disasm",
          "icon": "dist/resources/disasm-icon.svg"
        },
        {
          "id": "asmSidebar",
          "title": "asm",
          "icon": "dist/resources/asm-icon.svg"
        }
      ]
    },
    "views": {
      "disasmSidebar": [
        {
          "type": "webview",
          "id": "disasm.disasmPanel",
          "name": "Disasm Panel"
        }
      ],
      "asmSidebar": [
        {
          "type": "webview",
          "id": "asm.asmPanel",
          "name": "Asm Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "disasm.showPanel",
        "title": "Show Disasm Panel"
      },
      {
        "command": "asm.showPanel",
        "title": "Show Asm Panel"
      },
      {
        "command": "codedesigner.connectServer",
        "title": "CodeDesigner: Connect to Server"
      },
      {
        "command": "codedesigner.disconnectServer",
        "title": "CodeDesigner: Disconnect from Server"
      },
      {
        "command": "codedesigner.sendMessage",
        "title": "CodeDesigner: Send Message to Server"
      }
    ],
    "languages": [
      {
        "id": "cds",
        "aliases": [
          "Code Designer Source",
          "cds"
        ],
        "extensions": [
          ".cds"
        ],
        "configuration": "./dist/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cds",
        "scopeName": "source.cds",
        "path": "./syntaxes/cds.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "build": "npm run compile",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0"
  }
}
