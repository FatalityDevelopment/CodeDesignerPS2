{
  "name": "codedesigner",
  "displayName": "CodeDesigner",
  "description": "A very cool description",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.1"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "categories": [
    "Debuggers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerDev888/CodeDesigner.git"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "disasmSidebar",
          "title": "CodeDesigner",
          "icon": "dist/resources/codedesigner-icon.png"
        }
      ]
    },
    "views": {
      "disasmSidebar": [
        {
          "type": "webview",
          "id": "disasm.disasmPanel",
          "name": "Emulator"
        }
      ]
    },
    "commands": [
      {
        "command": "codedesigner.connectServer",
        "title": "CodeDesigner: Connect to Server"
      },
      {
        "command": "codedesigner.disconnectServer",
        "title": "CodeDesigner: Disconnect from Server"
      },
      {
        "command": "codedesigner.sendMessage",
        "title": "CodeDesigner: Send Message to Server"
      },
      {
        "command": "codedesigner.recompile",
        "title": "CodeDesigner: Recompile Game ELF from Disc"
      },
      {
        "command": "codedesigner.openElfFile",
        "title": "CodeDesigner: Open in Emulator (File Mode)"
      },
      {
        "command": "codedesigner.openGsFrameViewer",
        "title": "CodeDesigner: Open GS Frame Viewer (Live PCSX2 Display)"
      },
      {
        "command": "codedesigner.openJokerMaker",
        "title": "CodeDesigner: Open Joker Maker"
      },
      {
        "command": "codedesigner.openCompatBrowser",
        "title": "CodeDesigner: Open PS2 Game Compatibility"
      },
      {
        "command": "codedesigner.openMemoryCardBrowser",
        "title": "CodeDesigner: Open PS2 Memory Card Browser",
        "icon": "$(save)"
      },
      {
        "command": "codedesigner.openCheatsEditor",
        "title": "CodeDesigner: Open PS2 Cheats Editor"
      },
      {
        "command": "codedesigner.openStructureVisualizer",
        "title": "CodeDesigner: Open Structure Visualizer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codedesigner.toggleEmulatorConnection",
        "title": "CodeDesigner: Connect / Disconnect Emulator",
        "icon": "$(plug)"
      },
      {
        "command": "codedesigner.pointerManager.addPointer",
        "title": "Add Struct",
        "icon": "$(add)"
      },
      {
        "command": "codedesigner.pointerManager.addChildLabel",
        "title": "Add Child Label",
        "icon": "$(add)"
      },
      {
        "command": "codedesigner.pointerManager.editNode",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "codedesigner.pointerManager.deleteNode",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "codedesigner.pointerManager.goToAddress",
        "title": "Go to Address",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codedesigner.pointerManager.refresh",
        "title": "Refresh Structs",
        "icon": "$(refresh)"
      },
      {
        "command": "codedesigner.openStructCalculator",
        "title": "Open Struct Offset Calculator",
        "icon": "$(symbol-class)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codedesigner.toggleEmulatorConnection",
          "when": "view == disasm.disasmPanel",
          "group": "navigation"
        },
        {
          "command": "codedesigner.openStructureVisualizer",
          "when": "view == disasm.disasmPanel",
          "group": "navigation"
        },
        {
          "command": "codedesigner.openMemoryCardBrowser",
          "when": "view == disasm.disasmPanel",
          "group": "navigation"
        },
        {
          "command": "codedesigner.pointerManager.addPointer",
          "when": "view == disasm.pointerManager",
          "group": "navigation"
        },
        {
          "command": "codedesigner.pointerManager.refresh",
          "when": "view == disasm.pointerManager",
          "group": "navigation"
        },
        {
          "command": "codedesigner.openStructCalculator",
          "when": "view == disasm.pointerManager",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codedesigner.pointerManager.addChildLabel",
          "when": "view == disasm.pointerManager && (viewItem == pointerNode || viewItem == childPointerNode || viewItem == childLabelNode)",
          "group": "1_modify@1"
        },
        {
          "command": "codedesigner.pointerManager.editNode",
          "when": "view == disasm.pointerManager && (viewItem == pointerNode || viewItem == childLabelNode || viewItem == childPointerNode)",
          "group": "1_modify@2"
        },
        {
          "command": "codedesigner.pointerManager.deleteNode",
          "when": "view == disasm.pointerManager && (viewItem == pointerNode || viewItem == childLabelNode || viewItem == childPointerNode)",
          "group": "1_modify@3"
        },
        {
          "command": "codedesigner.pointerManager.goToAddress",
          "when": "view == disasm.pointerManager && (viewItem == pointerNode || viewItem == childLabelNode || viewItem == childPointerNode)",
          "group": "2_navigate@1"
        }
      ],
      "explorer/context": [
        {
          "command": "codedesigner.openMemoryCardBrowser",
          "when": "resourceExtname == .ps2 || resourceExtname == .mcd || resourceExtname == .mc2",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "cds",
        "aliases": [
          "Code Designer Source",
          "cds"
        ],
        "extensions": [
          ".cds"
        ],
        "configuration": "./dist/language-configuration.json"
      },
      {
        "id": "ps2-elf",
        "aliases": [
          "PS2 Executable",
          "PS2 ELF"
        ],
        "extensions": [
          ".elf",
          ".bin",
          ".raw"
        ]
      }
    ],
    "grammars": [
      {
        "language": "cds",
        "scopeName": "source.cds",
        "path": "./syntaxes/cds.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cds",
        "path": "./snippets/cds.code-snippets"
      }
    ],
    "customEditors": [
      {
        "viewType": "codedesigner.ps2File",
        "displayName": "CodeDesigner: PS2 File",
        "selector": [
          { "filenamePattern": "*.elf" },
          { "filenamePattern": "*.bin" },
          { "filenamePattern": "*.raw" }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          { "scope": "variable.register.zero.cds",    "settings": { "foreground": "#858585" } },
          { "scope": "variable.register.at.cds",      "settings": { "foreground": "#cca700" } },
          { "scope": "variable.register.value.cds",   "settings": { "foreground": "#b5cea8" } },
          { "scope": "variable.register.arg.cds",     "settings": { "foreground": "#ce9178" } },
          { "scope": "variable.register.temp.cds",    "settings": { "foreground": "#dcdcaa" } },
          { "scope": "variable.register.saved.cds",   "settings": { "foreground": "#9cdcfe" } },
          { "scope": "variable.register.kernel.cds",  "settings": { "foreground": "#f48771" } },
          { "scope": "variable.register.special.cds", "settings": { "foreground": "#4ec9b0" } },
          { "scope": "variable.register.fpu.cds",     "settings": { "foreground": "#b5cea8" } },
          { "scope": "variable.register.numeric.cds", "settings": { "foreground": "#9cdcfe" } },
          { "scope": "entity.name.function.definition.cds",  "settings": { "foreground": "#dcdcaa", "fontStyle": "bold" } },
          { "scope": "entity.name.function.declaration.cds", "settings": { "foreground": "#dcdcaa", "fontStyle": "italic" } },
          { "scope": "entity.name.function.call.cds",        "settings": { "foreground": "#dcdcaa" } },
          { "scope": "keyword.declaration.function.cds",     "settings": { "foreground": "#569cd6", "fontStyle": "bold" } },
          { "scope": "keyword.modifier.extern.cds",          "settings": { "foreground": "#569cd6" } },
          { "scope": "keyword.preprocessor.cds",             "settings": { "foreground": "#c586c0" } },
          { "scope": "keyword.directive.cds",                "settings": { "foreground": "#569cd6" } },
          { "scope": "keyword.sidecar.cds",                  "settings": { "foreground": "#4ec9b0" } },
          { "scope": "keyword.instruction.pseudo.cds",       "settings": { "foreground": "#9cdcfe", "fontStyle": "italic" } },
          { "scope": "keyword.other.at.cds",                 "settings": { "foreground": "#c586c0" } },
          { "scope": "variable.parameter.cds",               "settings": { "foreground": "#9cdcfe", "fontStyle": "italic" } },
          { "scope": "constant.character.escape.cds",        "settings": { "foreground": "#d7ba7d" } }
        ]
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "build": "npm run compile",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@angular/compiler-cli": "^19.2.19",
    "@babel/core": "^7.29.0",
    "@ngtools/webpack": "^19.2.22",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.19",
    "@angular/compiler": "^19.2.19",
    "@angular/core": "^19.2.19",
    "@angular/forms": "^19.2.19",
    "@angular/platform-browser": "^19.2.19",
    "@angular/platform-browser-dynamic": "^19.2.19",
    "@types/three": "^0.184.1",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "mermaid": "^11.4.1",
    "rxjs": "^7.8.2",
    "three": "^0.184.0",
    "zone.js": "^0.15.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3",
    "diff": ">=8.0.3"
  }
}
