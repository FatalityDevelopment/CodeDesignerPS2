<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodeDesigner.Ps2.McpServer</AssemblyName>
    <RootNamespace>CodeDesigner.Ps2.McpServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeDesigner.Ps2.CheatEngine\CodeDesigner.Ps2.CheatEngine.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.IsoManager\CodeDesigner.Ps2.IsoManager.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.Database\CodeDesigner.Ps2.Database.csproj" />
    <!-- SocketBridgeClient + McpDatabaseService now live in the shared infra lib. -->
    <ProjectReference Include="..\CodeDesigner.Ps2.McpInfra\CodeDesigner.Ps2.McpInfra.csproj" />
  </ItemGroup>

  <!--
    Deploy build output to a 'McpServer' subdirectory inside the CodeDesigner
    install directory so the VSCode extension and mcp.json can locate the MCP
    server without user configuration.  The subdirectory keeps McpServer
    assemblies isolated from the Bridge deployment to avoid DLL contamination
    (ModelContextProtocol pulls in Microsoft.Extensions.* 10.x which conflicts
    with the Bridge's 8.x dependencies).

    Install directory mirrors the C# DatabasePaths.GetInstallDirectory() logic:
      Windows     →  %LOCALAPPDATA%\CodeDesigner\McpServer\
      Linux/macOS →  $HOME/.local/share/CodeDesigner/McpServer/
  -->
  <Target Name="DeployToInstallDir" AfterTargets="Build">
    <PropertyGroup>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)</_LocalAppData>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' == '' AND '$(HOME)' != ''">$(HOME)/.local/share</_LocalAppData>
      <_InstallDir Condition="'$(_LocalAppData)' != ''">$(_LocalAppData)/CodeDesigner/McpServer</_InstallDir>
    </PropertyGroup>
    <MakeDir Directories="$(_InstallDir)" Condition="'$(_InstallDir)' != ''" />
    <ItemGroup Condition="'$(_InstallDir)' != ''">
      <_DeployFiles Include="$(OutputPath)**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_DeployFiles)"
      DestinationFiles="@(_DeployFiles->'$(_InstallDir)/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'$(_InstallDir)' != ''" />
    <Message Text="[CodeDesigner.McpServer] Deployed to $(_InstallDir)" Importance="high" Condition="'$(_InstallDir)' != ''" />
  </Target>

</Project>
