<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodeDesigner.AI.Abstractions</AssemblyName>
    <RootNamespace>CodeDesigner.AI.Abstractions</RootNamespace>
  </PropertyGroup>

  <!--
    Intentionally dependency-free (no MCP / EF / hosting packages). Tool projects
    reference only this library so they stay decoupled from the transport. The
    Server project is the only place that bridges these abstractions to MCP.
  -->

</Project>
