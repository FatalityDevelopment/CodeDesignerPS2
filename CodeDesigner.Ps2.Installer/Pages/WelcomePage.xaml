<UserControl x:Class="CodeDesigner.Ps2.Installer.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Hero area ──────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,0">

            <!-- Dragon-circle logo placeholder using the teal accent -->
            <Border Width="100" Height="100"
                    CornerRadius="50"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource AccentTealBrush}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18">
                <TextBlock Text="⬡"
                           FontSize="48"
                           Foreground="{StaticResource AccentTealBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="CodeDesigner"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource FgPrimaryBrush}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="PlayStation 2 Debugger &amp; Toolkit"
                       FontSize="14"
                       Foreground="{StaticResource AccentTealBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />

            <TextBlock Text="VS Code Extension"
                       FontSize="12"
                       Foreground="{StaticResource FgMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,24" />
        </StackPanel>

        <!-- ── Description ────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Margin="40,0" VerticalAlignment="Top">

            <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{StaticResource FgSecondaryBrush}"
                       Margin="0,0,0,16">
                This installer will set up CodeDesigner on your system by
                running a series of configuration scripts. The following
                tasks will be performed:
            </TextBlock>

            <StackPanel Margin="10,0,0,0">
                <TextBlock Style="{StaticResource StepLabel}">
                    <Run Text="•" Foreground="{StaticResource AccentTealBrush}" />
                    <Run Text="  Configure workspace and emulator settings" />
                </TextBlock>
                <TextBlock Style="{StaticResource StepLabel}">
                    <Run Text="•" Foreground="{StaticResource AccentTealBrush}" />
                    <Run Text="  Install the VS Code extension" />
                </TextBlock>
                <TextBlock Style="{StaticResource StepLabel}">
                    <Run Text="•" Foreground="{StaticResource AccentTealBrush}" />
                    <Run Text="  Set up required dependencies" />
                </TextBlock>
            </StackPanel>

            <!-- Discovered scripts list -->
            <TextBlock x:Name="ScriptCountLabel"
                       Text=""
                       FontSize="12"
                       Foreground="{StaticResource FgMutedBrush}"
                       Margin="0,24,0,4" />

            <ListBox x:Name="ScriptListBox"
                     MaxHeight="120"
                     Background="{StaticResource BgSecondaryBrush}"
                     Foreground="{StaticResource FgMutedBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     FontFamily="Cascadia Code, Consolas, monospace"
                     FontSize="12"
                     Padding="4"
                     Visibility="Collapsed" />
        </StackPanel>

        <!-- ── Bottom bar ─────────────────────────────────────────── -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0"
                Margin="0,16,0,0">
            <DockPanel LastChildFill="False" Margin="40,0">
                <Button x:Name="StartButton"
                        DockPanel.Dock="Right"
                        Content="Start"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Click="StartButton_Click" />

                <TextBlock DockPanel.Dock="Left"
                           Text="v1.0"
                           FontSize="11"
                           Foreground="{StaticResource FgMutedBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
