<UserControl x:Class="CodeDesigner.Ps2.Installer.Pages.CompletePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Main content ───────────────────────────────────────── -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- Status icon circle -->
            <Border x:Name="StatusCircle"
                    Width="80" Height="80"
                    CornerRadius="40"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource SuccessGreenBrush}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <TextBlock x:Name="StatusIcon"
                           Text="✓"
                           FontSize="36"
                           Foreground="{StaticResource SuccessGreenBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock x:Name="TitleLabel"
                       Text="Installation Complete!"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource FgPrimaryBrush}"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="DetailLabel"
                       Text="All scripts ran successfully."
                       FontSize="13"
                       Foreground="{StaticResource FgSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="360"
                       Margin="0,10,0,0" />

            <!-- Summary list -->
            <ItemsControl x:Name="SummaryList"
                          HorizontalAlignment="Center"
                          Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding Marker}"
                                       FontSize="13"
                                       Foreground="{Binding MarkerBrush}"
                                       Width="20" />
                            <TextBlock Text="{Binding FileName}"
                                       FontSize="13"
                                       Foreground="{StaticResource FgSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ── Bottom bar ─────────────────────────────────────────── -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Content="Close"
                        Style="{StaticResource PrimaryButton}"
                        Click="CloseButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
