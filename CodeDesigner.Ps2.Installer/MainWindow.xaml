<Window x:Class="CodeDesigner.Ps2.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeDesigner — Installer"
        Width="600" Height="560"
        MinWidth="500" MinHeight="450"
        Background="{StaticResource BgPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Title bar / step indicator ─────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource BgHeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="⬡"
                           FontSize="22"
                           Foreground="{StaticResource AccentTealBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <TextBlock DockPanel.Dock="Left"
                           Text="CodeDesigner Setup"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FgPrimaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Step indicators -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="Step1Dot" Text="●" FontSize="10"
                               Foreground="{StaticResource AccentTealBrush}"
                               Margin="0,0,6,0" />
                    <TextBlock x:Name="Step2Dot" Text="●" FontSize="10"
                               Foreground="{StaticResource FgMutedBrush}"
                               Margin="0,0,6,0" />
                    <TextBlock x:Name="Step3Dot" Text="●" FontSize="10"
                               Foreground="{StaticResource FgMutedBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Page host ──────────────────────────────────────────── -->
        <ContentControl x:Name="PageHost" Grid.Row="1" />
    </Grid>
</Window>
