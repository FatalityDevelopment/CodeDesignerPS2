<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CodeDesignerInstaller</AssemblyName>
    <AssemblyTitle>CodeDesigner Installer</AssemblyTitle>
    <Product>CodeDesigner</Product>
    <Description>CodeDesigner PS2 Toolkit Installer</Description>
  </PropertyGroup>

  <!-- Release builds ship as one self-contained exe so it runs on machines without .NET:
         dotnet publish -c Release -r win-x64 -p:ReleaseTag=v1.2.3
       ReleaseTag pins the GitHub release the installer downloads (empty = latest). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ReleaseTag" Value="$(ReleaseTag)" />
  </ItemGroup>

  <!-- The setup scripts travel inside the exe and are extracted at run time (ScriptRunner.ExtractScripts). -->
  <ItemGroup>
    <EmbeddedResource Include="Scripts\*.ps1;Scripts\*.psm1" LogicalName="Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
