<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeDesigner.Ps2.TestProject" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Coprocessors\**" />
    <Compile Remove="Instructions\**" />
    <Compile Remove="Tests\**" />
    <Compile Remove="VectorUnits\**" />
    <EmbeddedResource Remove="Coprocessors\**" />
    <EmbeddedResource Remove="Instructions\**" />
    <EmbeddedResource Remove="Tests\**" />
    <EmbeddedResource Remove="VectorUnits\**" />
    <None Remove="Coprocessors\**" />
    <None Remove="Instructions\**" />
    <None Remove="Tests\**" />
    <None Remove="VectorUnits\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeDesigner.Ps2.CdsLanguage\CodeDesigner.Ps2.CdsLanguage.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.CheatEngine\CodeDesigner.Ps2.CheatEngine.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.Common\CodeDesigner.Ps2.Common.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.Database\CodeDesigner.Ps2.Database.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.MCManager\CodeDesigner.Ps2.MCManager.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.HddManager\CodeDesigner.Ps2.HddManager.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.IsoManager\CodeDesigner.Ps2.IsoManager.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.LabelManager\CodeDesigner.Ps2.LabelManager.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.Multiplayer\CodeDesigner.Ps2.Multiplayer.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.Recompiler\CodeDesigner.Ps2.Recompiler.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.FileFormats\CodeDesigner.Ps2.FileFormats.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.DiscordPresence\CodeDesigner.Ps2.DiscordPresence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Isos\" />
    <Folder Include="Resources\Dumps\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Bios\SCPH-70004_BIOS_V12_PAL_200.BIN">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Bios\SCPH-70012_BIOS_V12_USA_200.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Bios\scph10000.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Isos\Gameshark 2 v4 PS2.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ps2-labels.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\MemoryCards\Mcd001.ps2">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.48.1" />
  </ItemGroup>

  <!--
    After every build, copy all output artefacts to the CodeDesigner install
    directory (the same folder that holds codedesigner.db).  This makes the
    Bridge executable available at a fixed, well-known path so the VS Code
    extension can auto-detect it without any user configuration.

    Install directory mirrors the C# DatabasePaths.GetInstallDirectory() logic:
      Windows  →  %LOCALAPPDATA%\CodeDesigner\
      Linux/macOS →  $HOME/.local/share/CodeDesigner/
  -->
  <Target Name="DeployToInstallDir" AfterTargets="Build">
    <PropertyGroup>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)</_LocalAppData>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' == '' AND '$(HOME)' != ''">$(HOME)/.local/share</_LocalAppData>
      <_InstallDir Condition="'$(_LocalAppData)' != ''">$(_LocalAppData)/CodeDesigner</_InstallDir>
    </PropertyGroup>
    <MakeDir Directories="$(_InstallDir)" Condition="'$(_InstallDir)' != ''" />
    <ItemGroup Condition="'$(_InstallDir)' != ''">
      <_DeployFiles Include="$(OutputPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFiles="@(_DeployFiles->'$(_InstallDir)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(_InstallDir)' != ''" />
    <Message Text="[CodeDesigner] Deployed to $(_InstallDir)" Importance="high" Condition="'$(_InstallDir)' != ''" />
  </Target>

</Project>
