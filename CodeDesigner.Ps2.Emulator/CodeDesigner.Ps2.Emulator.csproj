<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodeDesigner.Ps2.Emulator</RootNamespace>
    <AssemblyName>CodeDesigner.Ps2.Emulator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeDesigner.Ps2.Common\CodeDesigner.Ps2.Common.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.EmulatorCore\CodeDesigner.Ps2.EmulatorCore.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.IsoManager\CodeDesigner.Ps2.IsoManager.csproj" />
  </ItemGroup>

  <!--
    Mirror the deploy step in CodeDesigner.Ps2.Bridge: after every build, copy
    Emulator.exe and its dependencies to the install directory next to Bridge.exe
    so Bridge can spawn it without path configuration.
  -->
  <Target Name="DeployToInstallDir" AfterTargets="Build">
    <PropertyGroup>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)</_LocalAppData>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' == '' AND '$(HOME)' != ''">$(HOME)/.local/share</_LocalAppData>
      <_InstallDir Condition="'$(_LocalAppData)' != ''">$(_LocalAppData)/CodeDesigner</_InstallDir>
    </PropertyGroup>
    <MakeDir Directories="$(_InstallDir)" Condition="'$(_InstallDir)' != ''" />
    <ItemGroup Condition="'$(_InstallDir)' != ''">
      <_DeployFiles Include="$(OutputPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFiles="@(_DeployFiles->'$(_InstallDir)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(_InstallDir)' != ''" />
    <Message Text="[CodeDesigner] Deployed Emulator to $(_InstallDir)" Importance="high" Condition="'$(_InstallDir)' != ''" />
  </Target>

</Project>
