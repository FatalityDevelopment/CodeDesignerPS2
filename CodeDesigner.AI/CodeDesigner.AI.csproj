<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodeDesigner.AI</AssemblyName>
    <RootNamespace>CodeDesigner.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeDesigner.AI.Abstractions\CodeDesigner.AI.Abstractions.csproj" />
    <ProjectReference Include="..\CodeDesigner.AI.Tools.Core\CodeDesigner.AI.Tools.Core.csproj" />
    <ProjectReference Include="..\CodeDesigner.AI.Tools.Memory\CodeDesigner.AI.Tools.Memory.csproj" />
    <ProjectReference Include="..\CodeDesigner.AI.Tools.Debug\CodeDesigner.AI.Tools.Debug.csproj" />
    <ProjectReference Include="..\CodeDesigner.AI.Tools.Labels\CodeDesigner.AI.Tools.Labels.csproj" />
    <ProjectReference Include="..\CodeDesigner.AI.Tools.Network\CodeDesigner.AI.Tools.Network.csproj" />
    <ProjectReference Include="..\CodeDesigner.AI.Tools.Patching\CodeDesigner.AI.Tools.Patching.csproj" />
    <ProjectReference Include="..\CodeDesigner.AI.Tools.Assets\CodeDesigner.AI.Tools.Assets.csproj" />
    <ProjectReference Include="..\CodeDesigner.AI.Tools.Admin\CodeDesigner.AI.Tools.Admin.csproj" />
    <ProjectReference Include="..\CodeDesigner.Ps2.Database\CodeDesigner.Ps2.Database.csproj" />
  </ItemGroup>

  <!-- Reuse the legacy bridge + DB service via linked source (single source of truth). -->
  <ItemGroup>
    <Compile Include="..\CodeDesigner.Ps2.McpServer\SocketBridgeClient.cs" Link="Infra\SocketBridgeClient.cs" />
    <Compile Include="..\CodeDesigner.Ps2.McpServer\McpDatabaseService.cs" Link="Infra\McpDatabaseService.cs" />
  </ItemGroup>

  <!-- Deploy to %LOCALAPPDATA%\CodeDesigner\AI\ so it runs side-by-side with the legacy server. -->
  <Target Name="DeployToInstallDir" AfterTargets="Build">
    <PropertyGroup>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)</_LocalAppData>
      <_LocalAppData Condition="'$(LOCALAPPDATA)' == '' AND '$(HOME)' != ''">$(HOME)/.local/share</_LocalAppData>
      <_InstallDir Condition="'$(_LocalAppData)' != ''">$(_LocalAppData)/CodeDesigner/AI</_InstallDir>
    </PropertyGroup>
    <MakeDir Directories="$(_InstallDir)" Condition="'$(_InstallDir)' != ''" />
    <ItemGroup Condition="'$(_InstallDir)' != ''">
      <_DeployFiles Include="$(OutputPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)"
          DestinationFiles="@(_DeployFiles->'$(_InstallDir)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Condition="'$(_InstallDir)' != ''" />
    <Message Text="[CodeDesigner.AI] Deployed to $(_InstallDir)" Importance="high" Condition="'$(_InstallDir)' != ''" />
  </Target>

</Project>
